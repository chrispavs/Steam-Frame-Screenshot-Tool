    def display(self):
        return Gdk.Display.get_default()

    def _show_shortcut(self):
        self.value.set_label(shortcut_label(self.settings, self.display()))

    def _set_status(self, message, clear_after=5):
        if self._status_timer:
            GLib.source_remove(self._status_timer)
            self._status_timer = 0
        self.status.set_label(message)
        if not message or not clear_after:
            return

        def clear():
            self._status_timer = 0
            if self.status.get_label() == message:
                self.status.set_label("")
            return False

        self._status_timer = GLib.timeout_add_seconds(clear_after, clear)

    def _persist(self, message):
        save_settings(self.settings)
        self._set_status(message)

    def on_change(self, _button):
        if self.capturing:
            self._stop_capture()
            return
        self.capturing = True
        self.value.set_label("Press a shortcut…")
        self.change.set_label("Cancel")
        self.change.remove_css_class("suggested-action")
        self._set_status("Escape cancels.")

    def _stop_capture(self):
        self.capturing = False
        self.change.set_label("Change shortcut")
        self.change.add_css_class("suggested-action")
        self._show_shortcut()
        if self.status.get_label() == "Escape cancels.":
            self._set_status("")

    def on_reset(self, _button):
        if self.capturing:
            self._stop_capture()
        self.settings.update(evdev=3, ctrl=True, shift=True, alt=False, super=False)
        self._show_shortcut()
        self._persist("Restored Ctrl+Shift+2.")

    def on_picture(self, button):
        if button in (self.left_eye, self.right_eye, self.both_eyes) and not button.get_active():
            return
        if self.right_eye.get_active():
            self.settings["eye"] = "right"
        elif self.both_eyes.get_active():
            self.settings["eye"] = "both"
        else:
            self.settings["eye"] = "left"
        self.settings["open_after"] = self.open_after.get_active()
        self._persist("Saved.")

    def _show_sound(self):
        custom = self.settings["sound_file"]
        if custom:
            self.sound_name.set_label(Path(custom).name)
            self.sound_name.set_tooltip_text(custom)
            return
        self.sound_name.set_label("Built-in shutter")
        self.sound_name.set_tooltip_text("Plays the sound that comes with Frame Screenshot")

    def _show_volume(self):
        self.volume_value.set_label(f"{int(self.settings['sound_volume'])}%")

    def on_volume(self, scale):
        volume = max(0, min(100, int(round(scale.get_value()))))
        self.settings["sound_volume"] = volume
        self._show_volume()
        if self._volume_timer:
            GLib.source_remove(self._volume_timer)

        def commit():
            self._volume_timer = 0
            self._persist("Saved.")
            if volume > 0:
                self._preview_sound()
            return False

        self._volume_timer = GLib.timeout_add(250, commit)

    def _preview_sound(self):
        binary = frameshot_binary()
        if not binary:
            self._set_status("frameshot is not installed.")
            return
        try:
            Gio.Subprocess.new([binary, "--play-sound"], Gio.SubprocessFlags.NONE)
        except GLib.Error:
            self._set_status("Could not play the screenshot sound.")

    def on_sound_enabled(self, button):
        self.settings["sound"] = button.get_active()
        self._persist("Saved.")
        if button.get_active():
            self._preview_sound()

    def on_reset_sound(self, _button):
        if self._volume_timer:
            GLib.source_remove(self._volume_timer)
            self._volume_timer = 0
        self.settings["sound_file"] = ""
        self._show_sound()
        self._persist("Restored the built-in shutter.")
        if self.settings["sound_volume"] > 0:
            self._preview_sound()

    def on_change_sound(self, _button):
        dialog = Gtk.FileDialog()
        dialog.set_title("Change Sound")
        dialog.set_modal(True)
        audio = Gtk.FileFilter()
        audio.set_name("Sounds")
        for mime in ("audio/wav", "audio/x-wav", "audio/ogg", "audio/vorbis", "audio/flac", "audio/mpeg", "audio/mp3"):
            audio.add_mime_type(mime)
        for pattern in ("*.wav", "*.ogg", "*.oga", "*.flac", "*.mp3"):
            audio.add_pattern(pattern)
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(audio)
        dialog.set_filters(filters)
        dialog.set_default_filter(audio)
        current = self.settings["sound_file"]
        if current and os.path.isfile(current):
            dialog.set_initial_file(Gio.File.new_for_path(current))
        else:
            dialog.set_initial_folder(Gio.File.new_for_path(str(Path.home())))
        self._sound_dialog = dialog
        dialog.open(self, None, self.on_sound_chosen)

    def on_sound_chosen(self, dialog, result):
        try:
            chosen = dialog.open_finish(result)
        except GLib.Error:
            return
        path = chosen.get_path()
        if not path:
            self._set_status("That sound could not be used.")
            return
        builtin = default_sound_path()
        try:
            same = bool(builtin) and os.path.samefile(path, builtin)
        except OSError:
            same = False
        self.settings["sound_file"] = "" if same else path
        self._show_sound()
        self._persist("Saved.")
        self._preview_sound()

    def on_key(self, _controller, keyval, keycode, state):
        if not self.capturing:
            return False
        if keyval == Gdk.KEY_Escape:
            self._stop_capture()
            return True
        if keyval in MODIFIER_KEYVALS:
            return True
        mods = Gdk.ModifierType(state)
        ctrl = bool(mods & Gdk.ModifierType.CONTROL_MASK)
        shift = bool(mods & Gdk.ModifierType.SHIFT_MASK)
        alt = bool(mods & Gdk.ModifierType.ALT_MASK)
        super_key = bool(mods & (Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.META_MASK))
        evdev = keycode - 8
        if evdev <= 0 or evdev > 0x2FF:
            self._set_status("That key is not available.")
            return True
        if not (ctrl or shift or alt or super_key) and is_typing_key(self.display(), evdev):
            self._set_status("Add Ctrl, Alt, Shift, or Super so typing does not take a screenshot.")
            return True
        self.settings.update(evdev=evdev, ctrl=ctrl, shift=shift, alt=alt, super=super_key)
        self._stop_capture()
        self._persist("Saved. The shortcut updates within a second.")
        return True

    def on_take(self, _button):
        binary = frameshot_binary()
        if not binary:
            self._set_status("frameshot is not installed.")
            return
        flag = {"left": "--left", "right": "--right", "both": "--both"}.get(self.settings["eye"], "--left")
        args = [binary, flag, "--view"]
        Gio.Subprocess.new(args, Gio.SubprocessFlags.NONE)
        self._set_status("Taking a screenshot…")


class SettingsApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        windows = self.get_windows()
        if windows:
            windows[0].present()
            return
        SettingsWindow(self).present()


def main():
    app = SettingsApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
