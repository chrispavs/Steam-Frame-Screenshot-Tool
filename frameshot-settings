#!/usr/bin/env python3
"""Change the Frame Screenshot shortcut, picture, and sound options."""

import os
import sys
from pathlib import Path

# Gamescope's Vulkan swapchain can present a blank first frame. OpenGL is reliable
# here, and a restarted desktop can leave WAYLAND_DISPLAY pointing at a deleted socket.
os.environ.setdefault("GSK_RENDERER", "ngl")
os.environ.setdefault("GTK_A11Y", "none")
os.environ.setdefault("NO_AT_BRIDGE", "1")


def _prefer_reachable_display():
    name = os.environ.get("WAYLAND_DISPLAY", "")
    if not name:
        return
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    sock = name if name.startswith("/") else os.path.join(runtime, name)
    if sock and os.path.exists(sock):
        return
    if not os.environ.get("DISPLAY"):
        return
    os.environ.pop("WAYLAND_DISPLAY", None)
    os.environ["GDK_BACKEND"] = "x11"


_prefer_reachable_display()

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")

