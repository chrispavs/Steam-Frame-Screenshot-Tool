    Gdk.KEY_ISO_Level5_Shift,
    Gdk.KEY_Caps_Lock,
    Gdk.KEY_Num_Lock,
    Gdk.KEY_Scroll_Lock,
}

PRETTY = {
    "Print": "Print Screen",
    "Return": "Enter",
    "KP_Enter": "Enter",
    "BackSpace": "Backspace",
    "Prior": "Page Up",
    "Next": "Page Down",
    "Escape": "Esc",
    "space": "Space",
    "Tab": "Tab",
    "ISO_Left_Tab": "Tab",
}


def config_path():
    home = Path(os.environ.get("HOME", "."))
    config = os.environ.get("XDG_CONFIG_HOME")
    root = Path(config) if config else home / ".config"
    return root / "frameshot" / "settings"


def frameshot_binary():
    beside = Path(__file__).resolve().parent / "frameshot"
    if beside.is_file() and os.access(beside, os.X_OK):
        return str(beside)
    installed = Path.home() / ".local" / "bin" / "frameshot"
    if installed.is_file() and os.access(installed, os.X_OK):
        return str(installed)
    return None


def parse_bool(value):
    return value.strip() in {"1", "true", "yes", "on"}


def load_settings():
    settings = {
        "evdev": 3,
        "ctrl": True,
        "shift": True,
        "alt": False,
        "super": False,
        "eye": "left",
        "open_after": False,
        "sound": False,
        "sound_file": "",
        "sound_volume": 75,
    }
    path = config_path()
    if not path.is_file():
        return settings
    saw_eye = False
    legacy_both = None
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if key == "evdev":
            try:
                code = int(value)
            except ValueError:
                continue
            if 0 < code <= 0x2FF:
                settings["evdev"] = code
        elif key == "eye" and value in {"left", "right", "both"}:
            settings["eye"] = value
            saw_eye = True
        elif key == "both":
            legacy_both = parse_bool(value)
        elif key == "sound":
            settings["sound"] = parse_bool(value)
        elif key == "sound_file":
            settings["sound_file"] = value
        elif key == "sound_volume":
            try:
                volume = int(value)
            except ValueError:
                continue
            settings["sound_volume"] = max(0, min(100, volume))
        elif key in {"ctrl", "shift", "alt", "super", "open_after"}:
            settings[key] = parse_bool(value)
    if not saw_eye and legacy_both:
        settings["eye"] = "both"
    return settings


def save_settings(settings):
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    body = "\n".join(
        [
            f"evdev={settings['evdev']}",
            f"ctrl={int(settings['ctrl'])}",
            f"shift={int(settings['shift'])}",
            f"alt={int(settings['alt'])}",
            f"super={int(settings['super'])}",
            f"eye={settings['eye']}",
            f"open_after={int(settings['open_after'])}",
            f"sound={int(settings['sound'])}",
            f"sound_file={settings['sound_file']}",
            f"sound_volume={int(settings['sound_volume'])}",
            "",
        ]
    )
    temporary = path.with_name("settings.tmp")
    temporary.write_text(body, encoding="utf-8")
    temporary.replace(path)


def default_sound_path():
    candidates = []
    data = os.environ.get("XDG_DATA_HOME", "")
    if data:
        candidates.append(Path(data) / "frameshot" / "shutter.wav")
    candidates.append(Path.home() / ".local" / "share" / "frameshot" / "shutter.wav")
    candidates.append(Path(__file__).resolve().parent / "sounds" / "shutter.wav")
    for path in candidates:
        if path.is_file():
            return path
    return None


def pretty_keyval(keyval):
    name = Gdk.keyval_name(keyval) or "Unknown"
    if name in PRETTY:
        return PRETTY[name]
    if len(name) == 1 and name.isalpha():
        return name.upper()
    return name.replace("_", " ")


def shortcut_label(settings, display):
    parts = []
    if settings["ctrl"]:
        parts.append("Ctrl")
    if settings["alt"]:
        parts.append("Alt")
    if settings["shift"]:
        parts.append("Shift")
    if settings["super"]:
        parts.append("Super")
    keycode = settings["evdev"] + 8
    found, keyval, _group, _level, _consumed = display.translate_key(keycode, Gdk.ModifierType(0), 0)
    parts.append(pretty_keyval(keyval) if found else f"Key {settings['evdev']}")
    return "+".join(parts)


def is_typing_key(display, evdev):
    found, keyval, _group, _level, _consumed = display.translate_key(evdev + 8, Gdk.ModifierType(0), 0)
    return found and 32 <= keyval <= 126


